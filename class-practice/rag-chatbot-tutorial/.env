# RAG Chatbot Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragdb

# Model Configuration
# The model name as llmman knows it (run: llmman ls)
MODEL_NAME=gemma3:4b
# The port llmman serve listens on
LLMMAN_PORT=17434

# Optional: use Microsoft's Phi-4-mini instead
# (first run: llmman pull hf.co/unsloth/Phi-4-mini-instruct-GGUF)
# MODEL_NAME=hf.co/unsloth/Phi-4-mini-instruct-GGUF

# Optional: use a prebuilt app image instead of building ./app
# APP_IMAGE=
